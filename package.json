{
  "name": "dsh-autocontinue",
  "version": "0.1.13",
  "description": "Automatic same-session continuation for dsh: keep an idle agent working, and retry failed turns with backoff.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "autocontinue",
    "continuation",
    "goal",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenjoe41/dsh-autocontinue.git"
  },
  "homepage": "https://github.com/kenjoe41/dsh-autocontinue#readme",
  "bugs": {
    "url": "https://github.com/kenjoe41/dsh-autocontinue/issues"
  }
}
